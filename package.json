{
  "name": "ttym",
  "private": true,
  "description": "Web terminal multiplexer \u2014 single WebSocket, multiple PTY sessions",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "desktop:dev": "pnpm --dir packages/desktop tauri:dev",
    "desktop:build": "pnpm --dir packages/desktop tauri:build"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "better-sqlite3"
    ]
  },
  "dependencies": {
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "esbuild": "^0.27.3",
    "playwright": "^1.58.2",
    "vitest": "^3.2.4"
  }
}
