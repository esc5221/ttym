{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "paths": {
      "@xterm/headless": [
        "../server/node_modules/@xterm/headless"
      ],
      "@xterm/addon-serialize": [
        "../server/node_modules/@xterm/addon-serialize"
      ]
    }
  },
  "include": [
    "src"
  ]
}
