{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ttym",
  "version": "0.1.0",
  "identifier": "dev.ttym.native",
  "build": {
    "beforeBuildCommand": "cd ../.. && ./scripts/build.sh",
    "frontendDist": "../launcher"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "resources": [
      "../../../dist"
    ],
    "targets": [
      "app"
    ],
    "createUpdaterArtifacts": false
  }
}
