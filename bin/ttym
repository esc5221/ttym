#!/usr/bin/env node
// Thin launcher. The CLI lives in packages/cli/src/main.js and is bundled to
// dist/ttym by scripts/build.sh; running the source directly would need the
// workspace's TS packages resolved, which plain node cannot do.
import { spawnSync } from 'node:child_process';
import { existsSync } from 'node:fs';
import { resolve, dirname } from 'node:path';
import { fileURLToPath } from 'node:url';

const dist = resolve(dirname(fileURLToPath(import.meta.url)), '../dist/ttym');
if (!existsSync(dist)) {
  console.error(`built CLI not found: ${dist}\nrun: ./scripts/build.sh`);
  process.exit(1);
}
const r = spawnSync('node', [dist, ...process.argv.slice(2)], { stdio: 'inherit' });
process.exit(r.status ?? 1);
